# Copy to `.env` and fill in. `.env` is gitignored.

# Token guarding the webhook URL sources POST to (goes in the path):
#   https://hub.example.com/hook/<HUB_INGEST_TOKEN>
# Generate one: openssl rand -hex 24
HUB_INGEST_TOKEN=change-me-ingest

# Bearer token the app presents to read notifications.
# Generate one: openssl rand -hex 24
HUB_APP_TOKEN=change-me-app

# Optional (defaults shown)
HUB_PORT=8787
HUB_HOST=0.0.0.0
HUB_DB_PATH=./data/hub.db
HUB_RETENTION=500
HUB_LOG_LEVEL=info
