# Dev-only reverse proxy targets (used by vite.config.ts).
# These let the browser preview (npm run dev) reach your services same-origin,
# avoiding CORS. On device the app uses CapacitorHttp and ignores these.
# Copy to `.env` and fill with your real domains. `.env` is gitignored.

DEV_AUTHELIA_URL=https://auth.example.com
DEV_RADARR_URL=https://radarr.example.com
DEV_SONARR_URL=https://sonarr.example.com
DEV_GLANCES_URL=https://glances.example.com
DEV_JELLYFIN_URL=https://jellyfin.example.com
# Plex needs no entry: it is reached through plex.tv, which allows CORS.
# qBittorrent is reached through qui's Client Proxy — paste the full proxy URL
# (it embeds the API key): https://qui.example.com/proxy/<KEY>
DEV_QBITTORRENT_URL=https://qui.example.com/proxy/YOUR_QUI_PROXY_KEY
# Only if you connect to qBittorrent directly instead (Direct mode in the app).
DEV_QBITTORRENT_DIRECT_URL=https://qbittorrent.example.com
