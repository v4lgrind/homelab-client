# Dev-only reverse proxy targets (used by vite.config.ts).
# These let the browser preview (npm run dev) reach your services same-origin,
# avoiding CORS. On device the app uses CapacitorHttp and ignores these.
# Copy to `.env` and fill with your real domains. `.env` is gitignored.

DEV_AUTHELIA_URL=https://auth.example.com
DEV_RADARR_URL=https://radarr.example.com
DEV_SONARR_URL=https://sonarr.example.com
DEV_GLANCES_URL=https://glances.example.com
