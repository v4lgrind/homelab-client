# Normalise line endings — repo stores text as LF.
* text=auto eol=lf

# Scripts that must stay LF even on Windows checkouts
*.sh text eol=lf
gradlew text eol=lf

# Windows-only script
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.woff2 binary
*.keystore binary
*.jar binary
